<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: column; display: flex; visibility: visible; overflow: visible;">
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; align-items: auto; justify-content: space-between; align-self: center; padding-bottom: 37px; height: 213px; width: 894px; margin-bottom: 0;">
            <ui:Button text="Restart" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RestartButton" style="flex-shrink: 1; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; width: 390px; font-size: 62px; -unity-font-style: normal; height: 150px;" />
            <ui:Button text="Next Stage" parse-escape-sequences="true" display-tooltip-when-elided="true" name="NextStageButton" style="flex-shrink: 1; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; width: 390px; font-size: 64px; -unity-font-style: normal; height: 150px;" />
        </ui:VisualElement>
        <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" picking-mode="Ignore" name="ResultText" style="width: 100%; height: 100%; position: absolute; -unity-text-align: middle-center; font-size: 256px; color: rgb(255, 210, 0); -unity-font-style: bold;" />
    </ui:VisualElement>
</ui:UXML>
